--- !u!114 &1168262307
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1168262306}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3cfe9a3ed83cade45a1b11af5901a673, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  events:
  - name: NUBE
    image: {fileID: 21300000, guid: 60e71f934dafc194dbb613f1bc18556e, type: 3}
    text: "Tormenta de polvo peque\xF1a: \r\nEste fen\xF3meno se llama remolino de
      polvo marciano. Se forma cuando el Sol calienta el suelo de Marte y el aire
      caliente comienza a subir, haciendo que el viento gire y levante peque\xF1as
      part\xEDculas de polvo rojo."
    textColor: {r: 1, g: 1, b: 1, a: 0}
    fontSize: 25
    charsPerSecond: 30
    sound: {fileID: 8300000, guid: 3f53e2563958b7140b480a66b0d51737, type: 3}
    soundVolume: 0
    syncTypingToNarration: 0
    choiceA:
      label: USAR BATERIA DE EMERGENCIA
      effects:
      - bar: 0
        amount: -20
        randomBar: 0
      - bar: 1
        amount: 20
        randomBar: 0
    choiceB:
      label: POSPONER ACTIVIDADES
      effects:
      - bar: 0
        amount: 20
        randomBar: 0
      - bar: 2
        amount: -20
        randomBar: 0
  - name: TORMENTA
    image: {fileID: 21300000, guid: e041f50a3c1c3004fbac6106ed30d2f4, type: 3}
    text: "Tormenta de polvo grande:\r\nEste fen\xF3meno se forma cuando los fuertes
      vientos de Marte levantan grandes cantidades de polvo rojo del suelo. A diferencia
      de los peque\xF1os remolinos, estas tormentas pueden extenderse por enormes
      regiones."
    textColor: {r: 1, g: 1, b: 1, a: 0}
    fontSize: 25
    charsPerSecond: 30
    sound: {fileID: 8300000, guid: fd4756a8409963840b44d8692963002b, type: 3}
    soundVolume: 0
    syncTypingToNarration: 0
    choiceA:
      label: USAR BATERIA DE EMERGENCIA
      effects:
      - bar: 0
        amount: 10
        randomBar: 0
      - bar: 2
        amount: -30
        randomBar: 0
    choiceB:
      label: POSPONER ACTIVIDADES
      effects:
      - bar: 0
        amount: -40
        randomBar: 0
      - bar: 2
        amount: 10
        randomBar: 0
  - name: SOLAR
    image: {fileID: 21300000, guid: 16a819c64e4b2a34cb7794f3fcc812ab, type: 3}
    text: "Tormenta solar:\r\nLas tormentas solares ocurren cuando el Sol libera
      enormes cantidades de energ\xEDa y part\xEDculas cargadas que viajan por el
      espacio a gran velocidad.\r\nCuando estas part\xEDculas llegan a Marte, pueden
      interactuar con su atm\xF3sfera y provocar luces brillantes llamadas auroras."
    textColor: {r: 1, g: 1, b: 1, a: 0}
    fontSize: 25
    charsPerSecond: 30
    sound: {fileID: 8300000, guid: 6fbbc4bf29d64b84499eca4c6c389a0a, type: 3}
