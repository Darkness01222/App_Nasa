      - bar: 0
        amount: 20
        randomBar: 0
  - name: SISMO
    image: {fileID: 21300000, guid: aa53f0c258455e94fa15e24faf9c6efc, type: 3}
    text: "Sismo marciano: \r\nocurren cuando las rocas del interior de Marte se
      rompen o se mueven, liberando energ\xEDa que hace temblar el suelo.\r\nEsto
      puede suceder porque Marte se enfr\xEDa lentamente por dentro, provocando que
      su corteza se contraiga y se agriete.."
    textColor: {r: 1, g: 1, b: 1, a: 0}
